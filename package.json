{
  "name": "recoding-medicine-matchmaker",
  "version": "0.1.0",
  "private": true,
  "description": "Directory and matchmaking prototype pairing European health-data holders with AI/ML teams for the SPRIND Recoding Medicine challenge.",
  "scripts": {
    "dev": "pnpm --filter @rmm/web dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @rmm/web start",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "schema:export": "pnpm --filter @rmm/schema export-json-schema",
    "seed:validate": "pnpm --filter @rmm/schema validate-seed",
    "db:seed": "pnpm --filter @rmm/web db:seed"
  },
  "devDependencies": {
    "typescript": "5.7.3",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  }
}
