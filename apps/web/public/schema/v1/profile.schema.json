                  "pl",
                  "sv",
                  "da",
                  "he",
                  "fi",
                  "pt",
                  "el",
                  "cs",
                  "hu",
                  "ro",
                  "other"
                ]
              },
              "default": []
            },
            "looking_for": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "dataset_access",
                  "ai_partner",
                  "clinical_partner",
                  "data_governance_support",
                  "compute",
                  "not_looking"
                ]
              },
              "default": []
            },
            "application_status": {
              "type": "string",
              "enum": [
                "undecided",
                "intend_to_apply",
                "applying_with_partner",
                "team_complete",
                "not_applying"
              ]
            },
            "parallel_public_funding": {
              "type": "string",
              "enum": [
                "yes",
                "no",
                "unsure"
              ]
            },
