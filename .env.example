# ---------------------------------------------------------------------------
# Foresight Matchmaking — environment variables
# Copy to .env and fill in. Every variable is optional in development;
# SESSION_SECRET and ADMIN_SECRET are required in production.
# ---------------------------------------------------------------------------

# Signs the session cookies (HMAC-SHA256). Generate with: openssl rand -hex 32
# REQUIRED in production — the app refuses to issue sessions without it.
SESSION_SECRET=

# Shared secret for /admin and /api/v1/metrics.
# If unset, defaults to password123 (fine for demos — set a real one later).
ADMIN_SECRET=

# Where the SQLite file lives. Defaults to <repo root>/data/app.db.
# The Docker image sets this to the mounted volume.
# DATABASE_PATH=./data/app.db

# Public origin used in magic links and Open Graph (canonical host).
# Vercel (demo): https://foresightmatchmaker.app
# YCluster: https://foresight-matchmaker.dev.ycluster.net
# Defaults to the origin of the incoming request if unset.
# APP_URL=https://foresightmatchmaker.app

# Resend (preferred on Vercel) for magic links and introduction emails.
# SMTP_URL is the fallback for a VM with a mail relay.
# RESEND_API_KEY=
# SMTP_FROM=Foresight Matchmaking <hello@foresightmatchmaker.app>
# SMTP_URL=

# Privacy / data-subject request inbox shown in the footer and /privacy.
# Also used for beta bug reports (mailto from the footer and error page).
# Defaults to bradley@foresight.org if unset.
# PRIVACY_CONTACT_EMAIL=privacy@example.org

# Show magic links on screen when SMTP is unset.
# - In development: on by default (so `pnpm dev` works with zero infra).
# - In production: OFF by default — set to true only for a controlled demo.
#   Unknown emails still get a decoy link (anti-enumeration); real links
#   are also logged to the server console.
# AUTH_REVEAL_LINKS=true

# Load fabricated demo profiles only when the database is empty.
# Leave unset (or false) on any host that real applicants will see.
# Local rehearsal only: SEED_ON_EMPTY=true
# SEED_ON_EMPTY=

# Max outbound introduction requests one profile can send per rolling 24h.
# Defaults to 5. Raise this for a demo/rehearsal so repeated live run-throughs
# don't trip the limit right before you present.
# RATE_LIMIT_PER_24H=5

# Optional OpenAI-compatible endpoint for LLM features (profile pre-fill,
# match rationale, and — later — the match assistant). Any OpenAI-compatible
# gateway works; the Berlin Foresight node uses YCluster local-ai-proxy:
#   LLM_BASE_URL=https://dev1.ycluster.net/v1
#   LLM_MODEL=deepseek-v4-flash
#   LLM_API_KEY=sk-…   # mint at https://dev1.ycluster.net/admin/settings/api-keys
# Keys are shown once; revoke and recreate if leaked. Never commit the key.
# LLM_BASE_URL=https://dev1.ycluster.net/v1
# LLM_API_KEY=
# LLM_MODEL=deepseek-v4-flash
