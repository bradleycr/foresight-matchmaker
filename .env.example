# ---------------------------------------------------------------------------
# Recoding Medicine Matchmaker — environment variables
# Copy to .env and fill in. Every variable is optional in development;
# SESSION_SECRET and ADMIN_SECRET are required in production.
# ---------------------------------------------------------------------------

# Signs the session cookies (HMAC-SHA256). Generate with: openssl rand -hex 32
# REQUIRED in production — the app refuses to issue sessions without it.
SESSION_SECRET=

# Shared secret for /admin and /api/v1/metrics. Without it, admin is disabled.
ADMIN_SECRET=

# Where the SQLite file lives. Defaults to <repo root>/data/app.db.
# The Docker image sets this to the mounted volume.
# DATABASE_PATH=./data/app.db

# Public origin used in magic links (e.g. https://matchmaker.example.org).
# Defaults to the origin of the incoming request.
# APP_URL=

# SMTP connection URL for sending magic links, e.g.
#   smtps://user:pass@smtp.example.org:465
# When set, links are emailed and NEVER returned in API responses.
# SMTP_URL=
# SMTP_FROM=matchmaker@example.org

# Show magic links on screen when SMTP is unset.
# - In development: on by default (so `pnpm dev` works with zero infra).
# - In production: OFF by default — set to true only for a controlled demo.
#   Unknown emails still get a decoy link (anti-enumeration); real links
#   are also logged to the server console.
# AUTH_REVEAL_LINKS=true

# Optional OpenAI-compatible endpoint for the two non-blocking LLM features
# (profile pre-fill, match rationale prose). The app is fully functional
# without it; all tests pass with the LLM disabled.
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
